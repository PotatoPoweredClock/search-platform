# Copy to .env and fill in for local docker compose use. Never commit .env.

POSTGRES_DB=search_platform
POSTGRES_USER=search_platform
POSTGRES_PASSWORD=search_platform

# npm's public change feed
NPM_REGISTRY_CHANGES_URL=https://replicate.npmjs.com/_changes

ELASTICSEARCH_URIS=http://localhost:9200
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
